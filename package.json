  "author": "The tzin authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Charly921/tzin"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:ours": "tsc -p bench/tsconfig.ours.json --noEmit --extendedDiagnostics",
    "typecheck:hono": "tsc -p bench/tsconfig.hono.json --noEmit --extendedDiagnostics",
    "probe:mcp": "node scripts/mcp-client.mjs",
    "bench:lookup": "tsx bench/lookup.bench.mjs",
    "bench:http": "tsx bench/http.bench.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.2.0",
    "autocannon": "^8.0.0",
    "express": "^5.2.1",
    "hono": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
